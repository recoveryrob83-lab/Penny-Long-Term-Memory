{
  "manifest_version": 3,
  "name": "LifeOS V2 Local Courier",
  "version": "0.1.0",
  "description": "A local-only, human-supervised courier for registered ChatGPT routes.",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://chatgpt.com/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "LifeOS courier", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
